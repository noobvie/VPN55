# =============================================================================
# /etc/systemd/system/vpn55-panel.service
#
#   install:  install -o root -g root -m 0644 vpn55-panel.service \
#                     /etc/systemd/system/vpn55-panel.service
#             install -d -o root -g root -m 0700 /var/log/vpn55
#             systemctl daemon-reload && systemctl enable --now vpn55-panel
#
# The log directory is part of the install, not something the helper creates on
# first use: ReadWritePaths= below names it, and a path named there must exist
# or the unit refuses to start. See the hardening block for why that is
# deliberate, and why LogsDirectory= is the wrong way to create it.
#
# Its own unit, its own port, its own user. It shares a process with nothing
# public-facing, so a flaw in a public site is not a flaw in the panel and the
# other way round.
# =============================================================================

[Unit]
Description=VPN55 admin panel
Documentation=file:/usr/local/lib/vpn55/panel/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vpn55-panel
Group=vpn55-panel

WorkingDirectory=/usr/local/lib/vpn55/panel
ExecStart=/usr/bin/node /usr/local/lib/vpn55/panel/server.js
Environment=NODE_ENV=production
UMask=0027

# ── Restarting, and why the delay is not the default ────────────────────────
# The panel binds to the tunnel interface's address, which does not exist until
# the tunnel is up. systemd cannot express "after that interface has an address"
# — network-online.target does not wait for a tunnel a later unit brings up — so
# the honest arrangement is to let it fail and come back. config.js checks that
# the address is actually assigned and says so plainly, which turns those first
# few restarts into a readable log line rather than a bare EADDRNOTAVAIL.
Restart=on-failure
RestartSec=10s
# Do not give up. A tunnel down for a maintenance hour must not leave the panel
# permanently dead once it comes back.
StartLimitIntervalSec=0

# ── The state directory ─────────────────────────────────────────────────────
# ⚠ /var/lib/vpn55/panel/state.json holds the accumulated traffic totals, and
# they are DURABLE STATE, not a cache. Every service on this host resets its own
# counters, so losing this file sets every user's lifetime usage back to zero and
# nothing on the machine can rebuild it. It belongs in the backup.
StateDirectory=vpn55/panel
StateDirectoryMode=0750

# =============================================================================
# ⚠⚠ HARDENING — READ THIS BEFORE ADDING ANY OF THE USUAL OPTIONS ⚠⚠
# =============================================================================
#
# This service reaches root through TWO sudo rules and nothing else. sudo is
# setuid, and a
# setuid binary cannot raise privileges once the kernel's no_new_privs bit is
# set on the process.
#
# systemd sets that bit for you, WITHOUT BEING ASKED, whenever certain options
# are present. It is not a default you can override by writing
# NoNewPrivileges=no: the implication is applied after the unit is parsed, so an
# explicit `no` beside one of these options loses. Every one of the following
# turns it on, and this is why none of them appears in this file:
#
#     PrivateDevices=            ProtectKernelTunables=
#     ProtectClock=              ProtectKernelModules=
#     ProtectHostname=           ProtectKernelLogs=
#     RestrictRealtime=          RestrictSUIDSGID=
#     LockPersonality=           MemoryDenyWriteExecute=
#     SystemCallFilter=          RestrictNamespaces=
#
# The failure mode is what makes this worth a screen of comment. sudo does not
# say "no_new_privs is set". It says:
#
#     sudo: effective uid is not 0, is /usr/bin/sudo on a file system with the
#     'nosuid' option set or an NFS file system without root privileges?
#
# — which sends whoever is debugging it to look at mount options and filesystem
# permissions, neither of which is the problem, while the panel reports every
# service as unreadable.
#
# ── Two of them are worth naming separately ─────────────────────────────────
#
#   MemoryDenyWriteExecute=  would break this service even without the sudo
#       problem: V8 compiles JavaScript at runtime and needs pages that are both
#       writable and executable. The process dies at startup and nothing in the
#       message names this option.
#
#   SystemCallFilter=  is the one a hardening guide will most want to add. It is
#       also the one that most reliably breaks this unit, for the reason above.
#
# ── One more, which does NOT set no_new_privs and still breaks something ────
#
#   IPAddressDeny=any (with an allow list for the bind address) is the obvious
#       hardening for a service that only ever listens. It was true until
#       alerting existed. With alert_enabled=1 the panel makes ONE outbound
#       connection, to the webhook the operator configured, and an address
#       filter that does not allow it kills exactly that — silently, because a
#       blocked connect looks like a webhook that did not answer, and the whole
#       point of the alerts is that nobody is watching when they matter.
#
#       If you add one, allow the webhook's address, and check
#       `journalctl -u vpn55-panel | grep "could not deliver alert"` afterwards
#       rather than assuming.
#
# ── Verify rather than trust this comment ───────────────────────────────────
# After any change to this file:
#
#     systemctl show -p NoNewPrivileges vpn55-panel     # must print "no"
#     systemd-analyze security vpn55-panel              # for the rest
#
# If the first prints "yes", something in this unit turned it on and the status
# read will fail with the misleading message above. Find it and remove it — do
# not work around it by giving the panel user broader privileges.
#
# Two more, because a unit that starts is not a unit whose privileged path works
# — and neither of these fails at start-up, only at the first write:
#
#     systemctl show -p CapabilityBoundingSet vpn55-panel   # must NOT be empty
#     systemctl show -p ReadWritePaths vpn55-panel          # must list /etc/vpn55
#
# ── What IS safe here ───────────────────────────────────────────────────────
# The mount- and namespace-based protections below restrict what the process can
# SEE rather than what it can call, and none of them touches no_new_privs.
#
# But "safe" is not the same as "free": a mount namespace binds the sudo'd root
# child as well, so every one of them constrains the HELPER too. That is what
# ReadWritePaths= below is for, and it is why the capability bounding set is
# left alone. Read both before adding anything else here.
# =============================================================================

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid

# ── ReadWritePaths — and why root needs to be listed here at all ─────────────
#
# ⚠ A mount namespace is per-UNIT, and every descendant is inside it — INCLUDING
# the process sudo starts as root. `ProtectSystem=strict` therefore makes the
# whole hierarchy read-only for `helper/vpnctl` too, and root does not escape a
# read-only bind mount. Without the list below, all seven write verbs fail on
# their first write and `/var/log/vpn55/vpnctl.log` is never created at all —
# silently, because _ctl_audit is deliberately non-fatal so that an unwritable
# log can never block a revocation. That is the one log docs/security-model.md
# §6E.4 says survives a panel compromise, so its absence would be discovered on
# the day it was needed.
#
# This is the set the ROOT HELPER writes, not the panel:
#
#   /etc/vpn55       the user registry, the PKI, address leases, and each
#                    adapter's own state and hand-off spool
#   /var/log/vpn55   the helper's audit log
#   /etc/wireguard   the [Peer] block cred-add appends
#   /etc/openvpn     the per-client entry and the CRL
#   /etc/swanctl     the IKEv2 credentials
#
# ⚠ The last three are ADAPTER-SPECIFIC, so a fourth protocol adapter means a
# fourth line here. The failure if it is forgotten is a write verb that fails at
# runtime on a host where everything else works.
#
# The adapter paths are prefixed `-`, so a missing one is ignored rather than
# refusing to start: a host running only WireGuard has no /etc/swanctl, and that
# is the normal case rather than a misconfiguration.
#
# ⚠ The first two are NOT prefixed, and the asymmetry is the point. For an
# adapter directory, absent means "that protocol is not installed". For these
# two it means the registry or the audit log has nowhere to live — and the
# helper's own `mkdir -p` cannot rescue it, because /etc and /var/log are
# read-only inside this namespace. A start-up refusal naming the directory is
# the whole failure, said while somebody is looking; the alternative is a panel
# that runs and keeps no root-side audit trail at all, which is precisely the
# state docs/security-model.md §6E.4 exists to prevent.
#
# ⚠ Do NOT "fix" a missing /var/log/vpn55 with LogsDirectory=vpn55. systemd
# would create it owned by the SERVICE USER, and a log the panel can rewrite is
# not a log that survives a panel compromise — which is the only property that
# file has. It is root:root 0700, created by the install (see the header).
ReadWritePaths=/etc/vpn55
ReadWritePaths=/var/log/vpn55
ReadWritePaths=-/etc/wireguard
ReadWritePaths=-/etc/openvpn
ReadWritePaths=-/etc/swanctl

# ── The one path this service must never see ────────────────────────────────
# /var/backups/vpn55 holds the encrypted archive, and that archive contains the
# CERTIFICATE AUTHORITY'S PRIVATE KEY. DAC already stops the panel user reading
# a 0700 root-owned directory, but this service reaches root through two sudo
# rules and the mount namespace binds that root child too — so the exclusion is
# stated in the unit, where it holds for the helper as well.
#
# ⚠ There is deliberately no panel route, no vpnctl verb and no sudoers rule for
# backup or restore. A panel compromise costs the seven write verbs it already
# costs; it must not also cost the whole fleet's identity in one file. If a
# future release wants a "download the backup" button, the answer is no — read
# the passphrase note at the top of lib/core_backup.sh first.
#
# It is prefixed `-` because a host that has never taken a backup has no such
# directory, and a unit that refuses to start over a missing backup directory
# would take the panel down for the least urgent reason available.
InaccessiblePaths=-/var/backups/vpn55

# ── The capability bounding set is deliberately NOT restricted ───────────────
#
# ⚠ This file used to carry `CapabilityBoundingSet=` (empty), with a comment
# claiming sudo was unaffected because "the bounding set is re-established for
# the new process". That is not how the kernel works, and the claim cost nothing
# to write and everything to believe.
#
# The bounding set is inherited across execve and can only ever be DROPPED. On a
# setuid-root exec the kernel computes the new permitted set as
#
#     pP' = bset | pI          (security/commoncap.c, privileged-root case)
#
# so an empty bounding set means the process sudo starts has euid 0 and ZERO
# capabilities. sudo itself then fails first, at the setgroups()/setresgid(0)
# it does before exec: the file is setuid, not setgid, so gid 0 is not already
# in its saved set and the change needs CAP_SETGID, which is gone. This is the
# same breakage that empties `ping` under the identical setting. Had sudo
# survived it, `wg set` would have failed next for want of CAP_NET_ADMIN.
#
# Restricting the set to just what the adapters need was the other option and is
# rejected: it is a list that goes stale the day an adapter shells out to
# something new, and it goes stale silently.
#
# Nothing is lost by leaving it alone. The panel runs as an unprivileged user
# with no file capabilities, so its own effective and permitted sets are empty
# whatever the bounding set says — the bounding set constrains only what a
# future setuid exec may pick up, and the only setuid exec here is the one that
# is supposed to reach root.
#
# Ambient capabilities ARE emptied: that is this process's own set, it is
# already empty for a normal service user, and saying so costs nothing.
AmbientCapabilities=

# ── Logging ─────────────────────────────────────────────────────────────────
# stdout and stderr are the log; the panel opens no log file of its own and
# rotates nothing. `journalctl -u vpn55-panel` is the whole story.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpn55-panel

[Install]
WantedBy=multi-user.target
